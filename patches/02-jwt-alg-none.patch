# Патч 2/3: JWT alg:none forgery
# patch -p1 < patches/02-jwt-alg-none.patch

--- a/auth_jwt.py	2026-11-13 10:01:07.000000000 +0000
+++ b/auth_jwt.py	2026-11-14 01:10:37.348512885 +0000
@@ -1,11 +1,13 @@
+import os
 import base64
 import hashlib
 import hmac
 import json
 import time
 
-JWT_SECRET = "trading-api-2024"
+JWT_SECRET = os.environ.get("JWT_SECRET") or "dev-only-" + os.urandom(16).hex()
 JWT_TTL_SECONDS = 3600
+ALLOWED_ALG = "HS256"
 
 
 def _b64url_encode(data: bytes) -> str:
@@ -17,8 +19,8 @@
     return base64.urlsafe_b64decode(data + padding)
 
 
-def jwt_encode(payload: dict, secret: str = JWT_SECRET, alg: str = "HS256") -> str:
-    header = {"alg": alg, "typ": "JWT"}
+def jwt_encode(payload: dict, secret: str = JWT_SECRET) -> str:
+    header = {"alg": ALLOWED_ALG, "typ": "JWT"}
     body = dict(payload)
     body.setdefault("iat", int(time.time()))
     body.setdefault("exp", int(time.time()) + JWT_TTL_SECONDS)
@@ -26,11 +28,7 @@
     header_b64 = _b64url_encode(json.dumps(header, separators=(",", ":")).encode())
     payload_b64 = _b64url_encode(json.dumps(body, separators=(",", ":")).encode())
     signing_input = f"{header_b64}.{payload_b64}".encode()
-
-    if alg == "none":
-        signature = b""
-    else:
-        signature = hmac.new(secret.encode(), signing_input, hashlib.sha256).digest()
+    signature = hmac.new(secret.encode(), signing_input, hashlib.sha256).digest()
 
     sig_b64 = _b64url_encode(signature)
     return f"{header_b64}.{payload_b64}.{sig_b64}"
@@ -48,15 +46,14 @@
     except Exception as exc:
         raise JWTError("malformed token") from exc
 
-    alg = header.get("alg", "HS256")
-    if alg == "none":
-        pass
-    else:
-        signing_input = f"{header_b64}.{payload_b64}".encode()
-        expected_sig = hmac.new(secret.encode(), signing_input, hashlib.sha256).digest()
-        actual_sig = _b64url_decode(sig_b64)
-        if not hmac.compare_digest(expected_sig, actual_sig):
-            raise JWTError("bad signature")
+    if header.get("alg") != ALLOWED_ALG:
+        raise JWTError(f"unsupported alg, only {ALLOWED_ALG} is accepted")
+
+    signing_input = f"{header_b64}.{payload_b64}".encode()
+    expected_sig = hmac.new(secret.encode(), signing_input, hashlib.sha256).digest()
+    actual_sig = _b64url_decode(sig_b64)
+    if not hmac.compare_digest(expected_sig, actual_sig):
